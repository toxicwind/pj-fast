# Secrets / local config — never commit
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Run outputs (written under PJ_BASE_DIR, but keep local copies out too)
out*/
*.log
storage.json
*storage*.json

# Browser artifacts
*.png
*.jpg
*.webm
