# Papa John's project — template. Copy to .env and fill in your values.
# .env is gitignored; this file is safe to commit.

# Site / store
PJ_SITE_URL=https://www.papajohns.com
PJ_STORE_ID=1054
PJ_ZIP=YOUR_ZIP

# Checkout contact (used if a future script reaches checkout)
PJ_CONTACT_EMAIL=you@example.com
PJ_CONTACT_PHONE=YOUR_PHONE

# Machine-specific paths — override per box
PJ_BASE_DIR=/home/toxic/pj
PJ_CHROMIUM_PATH=/usr/bin/chromium

# Browser fingerprint
PJ_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
PJ_VIEWPORT_W=1366
PJ_VIEWPORT_H=900
PJ_LOCALE=en-US
PJ_TIMEZONE=America/Denver

# Menu SKUs
PJ_SKU_PHILLY_LARGE=1-1-4-198
PJ_SKU_PEPP_LARGE=1-1-4-115
PJ_SKU_PEPP_MEDIUM=1-1-3-115
PJ_SKU_WINGS_6PC=9-390-8-223
PJ_SKU_GARLIC_KNOTS=12-519-10-202

# Toppings / sauces (discovered IDs; Philly = onions removed, jalapenos added)
PJ_TOPPINGS_PHILLY=47,54,506,29
PJ_TOPPINGS_PEPPERONI=35
PJ_TOPPING_ONION=25
PJ_TOPPING_JALAPENO=29
PJ_SAUCE_PHILLY=428
PJ_SAUCE_PEPPERONI=429
PJ_INSTRUCTIONS=[{"detailId":58,"groupId":3},{"detailId":10,"groupId":4},{"detailId":1,"groupId":1},{"detailId":5,"groupId":2}]

# Product configuration IDs (discovered)
PJ_CONFIG_PHILLY_LARGE=16607
PJ_CONFIG_PEPP_LARGE=29630
PJ_CONFIG_PAIRING_A=10399
PJ_CONFIG_PAIRING_B=13664
PJ_CONFIG_PAIRING_C=18899
PJ_CONFIG_KNOTS=27247

# Deals + promo codes (validate per store with cart.validatePromoCode)
PJ_DEAL_BOGO=66564
PJ_DEAL_PAIRINGS=65515
PJ_DEAL_EDS8L=47851
PJ_PROMO_BOGO4U=BOGO4U
PJ_PROMO_SM25=SM25
PJ_PROMO_TAKE25DEAL=TAKE25DEAL
PJ_PROMO_PEPSI20=PEPSI20
PJ_PROMO_AMAC20=AMAC20
PJ_PROMO_EDCYO22=EDCYO22
PJ_PROMO_EDS8L=EDS8L
PJ_PROMO_EDMWP7=EDMWP7
